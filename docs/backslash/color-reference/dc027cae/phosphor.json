  "acceptedMath": {
    "srgbToLinear": "c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055)^2.4",
    "linearToSrgb": "c <= 0.0031308 ? c * 12.92 : 1.055 * c^(1/2.4) - 0.055",
    "luminanceWeights": [
      0.2126,
      0.7152,
      0.0722
    ],
    "original": "linear(saturate(premultipliedRgb / alpha)), only for alpha > 0",
    "endpoint": "linear(selectedRgb), except exact black -> (1,1,1)",
    "fullTint": "Y * endpoint",
    "partialTint": "lerp(originalLinear, saturate(Y * endpoint), strength)",
    "output": "sRGB(saturate(blended)) * originalPostCrtAlpha; preserve alpha",
    "zeroIntensity": "exact bypass with no conversion/clipping",
    "alphaZero": "transparent black when tint enabled",
    "order": [
      "source sample",
      "legacy float4 glow",
      "legacy float4 scanline modulation",
      "phosphor tint"
    ]
  },
